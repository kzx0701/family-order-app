{
    "bsonType": "object",
    "required": ["name", "type"],
    "permission": {
        "read": false,
        "create": false,
        "update": false,
        "delete": false
    },
    "properties": {
        "_id": {
            "description": "ID"
        },
        "name": {
            "bsonType": "string",
            "description": "菜品名称",
            "trim": "both",
            "label": "名称",
            "errorMessage": "菜品名称必填"
        },
        "image": {
            "bsonType": "string",
            "description": "菜品图片 URL（uniCloud 云存储）",
            "label": "图片",
            "defaultValue": ""
        },
        "description": {
            "bsonType": "string",
            "description": "菜品描述",
            "trim": "both",
            "label": "描述",
            "defaultValue": ""
        },
        "spicy": {
            "bsonType": "string",
            "description": "辣度：none 不辣 / mild 微辣 / medium 中辣（菜品默认辣度；将来若要支持「一菜多口味」再另加字段）",
            "enum": ["none", "mild", "medium"],
            "label": "辣度",
            "errorMessage": "辣度只能为 none / mild / medium",
            "defaultValue": "none"
        },
        "note": {
            "bsonType": "string",
            "description": "菜品备注（做饭人的经验提醒，如「收汁时留一点汤汁，土豆拌饭真的很香」）",
            "trim": "both",
            "maxLength": 200,
            "label": "备注",
            "errorMessage": "备注最多 200 字",
            "defaultValue": ""
        },
        "ingredients": {
            "bsonType": "array",
            "description": "食材列表。只存对 materials 集合的引用 + 本菜用量，名称与图片不复制 —— 物料改名或换图只需改一处，所有引用它的菜品同步生效",
            "arrayType": "object",
            "label": "食材",
            "defaultValue": [],
            "properties": {
                "materialId": {
                    "bsonType": "string",
                    "description": "物料 ID（materials 集合，group 为 ingredient）",
                    "label": "物料"
                },
                "quantity": {
                    "bsonType": "string",
                    "description": "本菜用量（自由文本，如「300 g」「4 瓣」）。用量随菜而异，故存在引用处而非物料表；物料表里的 defaultQuantity 只是新增时的预填值",
                    "trim": "both",
                    "defaultValue": "",
                    "label": "用量"
                }
            }
        },
        "seasonings": {
            "bsonType": "array",
            "description": "调料列表。结构与 ingredients 完全一致，仅分组不同；与食材分成两个数组是为了 UI 直接映射（详情页分「食材 / 调料」两栏展示）",
            "arrayType": "object",
            "label": "调料",
            "defaultValue": [],
            "properties": {
                "materialId": {
                    "bsonType": "string",
                    "description": "物料 ID（materials 集合，group 为 seasoning）",
                    "label": "物料"
                },
                "quantity": {
                    "bsonType": "string",
                    "description": "本菜用量（自由文本，如「10 ml」「1 小勺」）",
                    "trim": "both",
                    "defaultValue": "",
                    "label": "用量"
                }
            }
        },
        "type": {
            "bsonType": "string",
            "description": "类型：coffee 咖啡 / food 美食",
            "enum": ["coffee", "food"],
            "label": "类型",
            "errorMessage": "类型必填且只能为 coffee 或 food"
        },
        "categoryId": {
            "bsonType": "string",
            "description": "所属分类 ID",
            "label": "分类",
            "defaultValue": ""
        },
        "isOnSale": {
            "bsonType": "bool",
            "description": "是否上架",
            "defaultValue": true,
            "label": "上架状态"
        },
        "isRecommended": {
            "bsonType": "bool",
            "description": "是否推荐（推荐菜品显示在点单页推荐区）",
            "defaultValue": false,
            "label": "推荐状态"
        },
        "isSignature": {
            "bsonType": "bool",
            "description": "是否招牌（本家拿手菜，菜谱/菜单上打「家的拿手菜」标记，与「推荐」是两个独立标记）",
            "defaultValue": false,
            "label": "招牌"
        },
        "sortOrder": {
            "bsonType": "int",
            "description": "排序值（越小越靠前）",
            "defaultValue": 0,
            "label": "排序"
        },
        "createTime": {
            "bsonType": "timestamp",
            "description": "创建时间",
            "forceDefaultValue": {
                "$env": "now"
            }
        },
        "updateTime": {
            "bsonType": "timestamp",
            "description": "更新时间",
            "forceDefaultValue": {
                "$env": "now"
            }
        }
    }
}

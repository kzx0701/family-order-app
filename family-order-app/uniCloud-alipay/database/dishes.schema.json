{
    "bsonType": "object",
    "required": ["name", "type"],
    "permission": {
        "read": false,
        "create": false,
        "update": false,
        "delete": false
    },
    "properties": {
        "_id": {
            "description": "ID"
        },
        "name": {
            "bsonType": "string",
            "description": "菜品名称",
            "trim": "both",
            "label": "名称",
            "errorMessage": "菜品名称必填"
        },
        "image": {
            "bsonType": "string",
            "description": "菜品图片 URL（uniCloud 云存储）",
            "label": "图片",
            "defaultValue": ""
        },
        "description": {
            "bsonType": "string",
            "description": "菜品描述",
            "trim": "both",
            "label": "描述",
            "defaultValue": ""
        },
        "spicy": {
            "bsonType": "string",
            "description": "辣度：none 不辣 / mild 微辣 / medium 中辣 / hot 特辣。未设置或值非法时按 none 处理（详情页对 none 不显示辣度图标，微辣 1 根辣椒、中辣 2 根、特辣 3 根）",
            "enum": ["none", "mild", "medium", "hot"],
            "label": "辣度",
            "errorMessage": "辣度只能为 none / mild / medium / hot",
            "defaultValue": "none"
        },
        "note": {
            "bsonType": "string",
            "description": "菜品备注（做饭人的经验提醒，如「收汁时留一点汤汁，土豆拌饭真的很香」）",
            "trim": "both",
            "maxLength": 200,
            "label": "备注",
            "errorMessage": "备注最多 200 字",
            "defaultValue": ""
        },
        "ingredients": {
            "bsonType": "array",
            "description": "食材列表。只存对 materials 集合的引用 + 本菜用量，名称与图片不复制 —— 物料改名或换图只需改一处，所有引用它的菜品同步生效。⚠️ 这个字段**被两类菜品共用**：美食存「食材」（物料 group=ingredient），咖啡存「原料」（物料 group=coffee）—— 字段与物料分组是两回事，所以新增一个物料分组不需要动 dishes",
            "arrayType": "object",
            "label": "食材",
            "defaultValue": [],
            "properties": {
                "materialId": {
                    "bsonType": "string",
                    "description": "物料 ID（materials 集合，group 为 ingredient 或 coffee）",
                    "label": "物料"
                },
                "quantity": {
                    "bsonType": "string",
                    "description": "本菜用量（自由文本，如「300 g」「4 瓣」）。用量随菜而异，故存在引用处而非物料表；物料表的 unit 只描述该物料惯用什么单位，可作书写参考",
                    "trim": "both",
                    "defaultValue": "",
                    "label": "用量"
                }
            }
        },
        "seasonings": {
            "bsonType": "array",
            "description": "调料列表。结构与 ingredients 完全一致，仅分组不同；与食材分成两个数组是为了 UI 直接映射（详情页分「食材 / 调料」两栏展示）。**只有美食用它**：咖啡菜品没有调料区，原料全部存在 ingredients 里",
            "arrayType": "object",
            "label": "调料",
            "defaultValue": [],
            "properties": {
                "materialId": {
                    "bsonType": "string",
                    "description": "物料 ID（materials 集合，group 为 seasoning）",
                    "label": "物料"
                },
                "quantity": {
                    "bsonType": "string",
                    "description": "本菜用量（自由文本，如「10 ml」「1 小勺」）",
                    "trim": "both",
                    "defaultValue": "",
                    "label": "用量"
                }
            }
        },
        "steps": {
            "bsonType": "array",
            "description": "制作步骤。数组顺序即步骤顺序（与详情页编辑器里 draft.steps 的顺序一致），故元素不存 order —— 数组本身有序，再加字段反而要额外维护一致性。元素也不存 id：那是前端渲染用的标识（v-for 的 key、scrollTo 的锚点），不属于业务数据，前端每次读取时按位置生成",
            "arrayType": "object",
            "label": "制作步骤",
            "defaultValue": [],
            "properties": {
                "title": {
                    "bsonType": "string",
                    "description": "步骤名称（必填，如「洗洗青菜，切切蒜」）",
                    "trim": "both",
                    "maxLength": 50,
                    "label": "步骤名称",
                    "errorMessage": "步骤名称最多 50 字"
                },
                "description": {
                    "bsonType": "string",
                    "description": "步骤详情（选填：做法、火候、时间）",
                    "trim": "both",
                    "maxLength": 1000,
                    "defaultValue": "",
                    "label": "步骤详情",
                    "errorMessage": "步骤详情最多 1000 字"
                },
                "tip": {
                    "bsonType": "string",
                    "description": "注意事项（选填：小诀窍、容易翻车的地方）",
                    "trim": "both",
                    "maxLength": 300,
                    "defaultValue": "",
                    "label": "注意事项",
                    "errorMessage": "注意事项最多 300 字"
                }
            }
        },
        "type": {
            "bsonType": "string",
            "description": "类型：coffee 咖啡 / food 美食",
            "enum": ["coffee", "food"],
            "label": "类型",
            "errorMessage": "类型必填且只能为 coffee 或 food"
        },
        "categoryId": {
            "bsonType": "string",
            "description": "所属分类 ID",
            "label": "分类",
            "defaultValue": ""
        },
        "isOnSale": {
            "bsonType": "bool",
            "description": "是否上架",
            "defaultValue": true,
            "label": "上架状态"
        },
        "isSignature": {
            "bsonType": "bool",
            "description": "是否招牌（本家拿手菜，菜谱/菜单上打「家的拿手菜」标记，与「推荐」是两个独立标记）",
            "defaultValue": false,
            "label": "招牌"
        },
        "sortOrder": {
            "bsonType": "int",
            "description": "排序值（越小越靠前）",
            "defaultValue": 0,
            "label": "排序"
        },
        "createTime": {
            "bsonType": "timestamp",
            "description": "创建时间",
            "forceDefaultValue": {
                "$env": "now"
            }
        },
        "updateTime": {
            "bsonType": "timestamp",
            "description": "更新时间",
            "forceDefaultValue": {
                "$env": "now"
            }
        }
    }
}

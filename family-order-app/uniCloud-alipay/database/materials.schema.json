{
    "bsonType": "object",
    "required": ["name", "group"],
    "permission": {
        "read": false,
        "create": false,
        "update": false,
        "delete": false
    },
    "properties": {
        "_id": {
            "description": "ID"
        },
        "name": {
            "bsonType": "string",
            "description": "物料名称",
            "trim": "both",
            "label": "名称",
            "errorMessage": "物料名称必填"
        },
        "group": {
            "bsonType": "string",
            "description": "所属分组：ingredient 食材 / seasoning 调料 / coffee 咖啡原料。三者字段完全同构，故合并为一张表、靠本字段区分。语义上**一个分组 = 一个抽屉候选池**（编辑页的食材 / 调料 / 原料抽屉各自只看一组），所以新增分组只需扩展 enum —— 不必建表，也不必动 dishes（那边只存 materialId 引用，与分组无关）",
            "enum": ["ingredient", "seasoning", "coffee"],
            "label": "分组",
            "errorMessage": "分组必填，只能是 ingredient / seasoning / coffee 之一"
        },
        "image": {
            "bsonType": "string",
            "description": "物料图片地址（云存储）。每个物料一张，建议生成时统一规格（尺寸 / 比例 / 透明底一致），列表渲染才能共用同一套裁切逻辑",
            "defaultValue": "",
            "label": "图片"
        },
        "unit": {
            "bsonType": "string",
            "description": "计量单位，常用值：g / ml / 个 / 只 / 条 / 根 / 片 / 瓣 / 朵 / 块 / 把 / 勺 / 适量。仅描述该物料惯用什么单位计量，具体用量仍按自由文本存在菜品对它的引用里（dishes.ingredients[].quantity），此处不做结构化与换算",
            "trim": "both",
            "maxLength": 8,
            "defaultValue": "",
            "label": "单位",
            "errorMessage": "单位最多 8 个字"
        },
        "sortOrder": {
            "bsonType": "int",
            "description": "排序值（越小越靠前）",
            "defaultValue": 0,
            "label": "排序"
        },
        "isActive": {
            "bsonType": "bool",
            "description": "是否启用（软删除）。停用后不再出现在选择器中，但已被菜品引用的仍能正常渲染，避免菜品里留下查不到的 ID 变成空白格",
            "defaultValue": true,
            "label": "启用"
        },
        "createTime": {
            "bsonType": "timestamp",
            "description": "创建时间",
            "forceDefaultValue": {
                "$env": "now"
            }
        },
        "updateTime": {
            "bsonType": "timestamp",
            "description": "更新时间",
            "forceDefaultValue": {
                "$env": "now"
            }
        }
    }
}

{
    "bsonType": "object",
    "required": ["name", "type"],
    "permission": {
        "read": false,
        "create": false,
        "update": false,
        "delete": false
    },
    "properties": {
        "_id": {
            "description": "ID"
        },
        "name": {
            "bsonType": "string",
            "description": "分类名称",
            "trim": "both",
            "label": "名称",
            "errorMessage": "分类名称必填"
        },
        "type": {
            "bsonType": "string",
            "description": "所属类型：coffee 咖啡 / food 美食",
            "enum": ["coffee", "food"],
            "label": "类型",
            "errorMessage": "类型必填且只能为 coffee 或 food"
        },
        "image": {
            "bsonType": "string",
            "description": "分类图标（云存储地址或本地素材路径）。选择抽屉与菜品分类徽标用它展示；留空时页面回退到内置占位图，所以可以先不填",
            "trim": "both",
            "defaultValue": "",
            "label": "图标"
        },
        "sortOrder": {
            "bsonType": "int",
            "description": "排序值（越小越靠前）",
            "defaultValue": 0,
            "label": "排序"
        },
        "createTime": {
            "bsonType": "timestamp",
            "description": "创建时间",
            "forceDefaultValue": {
                "$env": "now"
            }
        }
    }
}

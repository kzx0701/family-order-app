.default-avatar.data-v-aac8b966 {
  position: relative;
  width: 100%;
  height: 100%;
  /* 跟随父容器的圆角形状：pages/my 的 .avatar-wrap 用手绘不规则圆，
     若此处写死 50% 正圆会把它盖住、丢掉手绘感 */
  border-radius: inherit;
  overflow: hidden;
}
.avatar-art.data-v-aac8b966 {
  width: 100%;
  height: 100%;
}

/* 男生素材的人物在 1254×1254 画布中占比偏小（头部小于女生素材约三成），
 * 放大以让两张头像的脸部尺寸在圆形内视觉一致。
 * 1.15 为去掉外框间隙、图片区域放大到 140rpx 后的实测值 */
.avatar-art--boy.data-v-aac8b966 {
  transform: scale(1.15);
}
.status-badge.data-v-e1449fbd {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 20rpx;
  border-radius: 9999px;
  font-size: 10px;
  font-weight: 600;
  line-height: 1.2;
  /* 颜色变化时丝滑过渡 */
  transition: background-color 250ms cubic-bezier(0.4, 0, 0.2, 1), color 250ms cubic-bezier(0.4, 0, 0.2, 1);
}
.status-badge .status-dot.data-v-e1449fbd {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.6);
  /* pending 状态加呼吸动效，吸引管理员注意 */
  animation: dotPulse-e1449fbd 1.6s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  transition: background-color 250ms cubic-bezier(0.4, 0, 0.2, 1);
}
@keyframes dotPulse-e1449fbd {
0%, 100% {
    opacity: 1;
    transform: scale(1);
}
50% {
    opacity: 0.6;
    transform: scale(0.85);
}
}
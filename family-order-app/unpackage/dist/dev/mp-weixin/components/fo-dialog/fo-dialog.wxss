.fo-dialog-root.data-v-4f6657b2 {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  /* 需盖住 fixed 的自定义 tabbar（其层级低于此） */
  z-index: 1200;
}
.fo-dialog-mask.data-v-4f6657b2 {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(44, 27, 20, 0.45);
  /* fill-mode 用 backwards 而不是 both：both 会在动画结束后保留终态，
   * 后续的出场过渡（改 opacity）就会被 animation 的填充值压住、播不出来 */
  animation: fadeIn 260ms cubic-bezier(0.22, 0.75, 0.24, 1) backwards;
  transition: opacity 140ms cubic-bezier(0.22, 0.75, 0.24, 1);
}

/* 承载层：左右各留 90rpx，卡片宽因此为 570rpx（屏宽的 76%，
 * 与系统弹窗的观感比例接近，不至于铺得太满）。
 * 底部留约 12vh：卡片整体略偏上，输入框聚焦唤起键盘时不会被下半屏压住。 */
.fo-dialog-layer.data-v-4f6657b2 {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 90rpx 12vh;
}

/* 二期手绘卡：奶油白底 + 深棕描边 + 不规则圆角 + 硬投影 */
.fo-dialog-card.data-v-4f6657b2 {
  width: 100%;
  /* 上下左右统一 40rpx：原先上方 44rpx 与下方 40rpx 不对称，也没有存在理由 */
  padding: 40rpx;
  background-color: #fffef9;
  border: 4rpx solid #765540;
  border-radius: 34rpx 42rpx 30rpx 40rpx;
  box-shadow: 7rpx 8rpx 0 rgba(98, 71, 53, 0.14);
  animation: slideUp 260ms cubic-bezier(0.22, 0.75, 0.24, 1) backwards;
  transition: opacity 140ms cubic-bezier(0.22, 0.75, 0.24, 1), transform 140ms cubic-bezier(0.22, 0.75, 0.24, 1);
}

/* 出场：整体淡出并轻微下沉，与入场的上浮方向相反但不回弹 */
.fo-dialog-root--closing .fo-dialog-mask.data-v-4f6657b2 {
  opacity: 0;
}
.fo-dialog-root--closing .fo-dialog-card.data-v-4f6657b2 {
  opacity: 0;
  transform: translateY(18rpx);
}
.fo-dialog-title.data-v-4f6657b2 {
  display: block;
  text-align: center;
  /* 手绘体：单字重，固定 normal 避免合成加粗糊掉笔触（首页 / 引导页 / 登录页同样处理） */
  font-family: MaokenWeb, MaokenHand, -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  /* $p2-fs-title（36rpx）。依据不是「看上去该多大」，而是三条：
   * ① 项目一期 fo-sheet 的弹窗标题 = $font-size-lg(32rpx)，二期对齐并上浮一档；
   * ② iOS HIG 的 Alert 标题 17pt ≈ 34rpx（Material 3 的 24sp ≈ 48rpx 属另一套更重的语言，
   *    本项目是 iOS 风格的暖色手绘风，取 iOS 那一档）；
   * ③ 与控件文字（$p2-fs-control 32rpx）差一档，层级比 1.125 —— 与一期 fo-sheet 的
   *    标题/正文比（32/28 ≈ 1.14）同量级。手绘体不能加字重（会合成加粗糊掉笔触），
   *    层级只能靠这一档字号差表达。 */
  font-size: 36rpx;
  font-weight: normal;
  line-height: 1.3;
  color: #624735;
}
.fo-dialog-subtitle.data-v-4f6657b2 {
  display: block;
  margin-top: 10rpx;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.5;
  color: #8c725e;
}
.fo-dialog-body.data-v-4f6657b2 {
  margin-top: 36rpx;
}

/* 输入框：内嵌奶油底 + 描边，聚焦时描边转珊瑚色 */
.fo-dialog-field.data-v-4f6657b2 {
  height: 96rpx;
  padding: 0 28rpx;
  background-color: #fff9ed;
  border: 3rpx solid #765540;
  border-radius: 20rpx 26rpx 18rpx 24rpx;
  transition: border-color 140ms cubic-bezier(0.22, 0.75, 0.24, 1);
}
.fo-dialog-field.is-focused.data-v-4f6657b2 {
  border-color: #e97a69;
}
.fo-dialog-input.data-v-4f6657b2 {
  width: 100%;
  height: 100%;
  /* 控件文字统一此档（输入框与按钮同号）。32rpx 同时是小程序 input 的默认字号 */
  font-size: 32rpx;
  color: #624735;
}
.fo-dialog-actions.data-v-4f6657b2 {
  display: flex;
  gap: 24rpx;
  margin-top: 36rpx;
}
.fo-dialog-btn.data-v-4f6657b2 {
  /* 与输入框等高同字号：96rpx 高 + $p2-fs-control。原先 92rpx / 30rpx 与输入框各差一档，
   * 弹窗里这三块控件本就该是同一套尺寸 */
  height: 96rpx;
  font-size: 32rpx;
  flex: 1;
  letter-spacing: 1rpx;
  border: 3rpx solid #765540;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 110ms cubic-bezier(0.22, 0.75, 0.24, 1);
  /* 两个按钮等宽（各占一半）：主次已由「描边 vs 实心珊瑚」承担，
  * 再靠宽度拉开就会显得两边不齐 —— 系统弹窗也是等宽的 */
  /* 主操作：珊瑚底 + 硬投影，与登录按钮同一套语言 */
}
.fo-dialog-btn.data-v-4f6657b2:active {
  transform: scale(0.97);
}
.fo-dialog-btn--cancel.data-v-4f6657b2 {
  background-color: #fff9ed;
  color: #624735;
  border-radius: 44rpx 40rpx 46rpx 42rpx;
}
.fo-dialog-btn--confirm.data-v-4f6657b2 {
  background-color: #e97a69;
  color: #fffef9;
  border-radius: 40rpx 46rpx 42rpx 44rpx;
  box-shadow: 4rpx 5rpx 0 rgba(98, 71, 53, 0.12);
}
.fo-dialog-btn--confirm.is-disabled.data-v-4f6657b2 {
  opacity: 0.45;
}
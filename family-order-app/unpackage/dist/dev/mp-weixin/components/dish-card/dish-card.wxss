.dish-card.data-v-215fb416 {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background-color: #FFFFFF;
  border: 2rpx solid var(--theme-card-border, #F5E6D3);
  border-radius: 16px;
  box-shadow: 0 1px 2px rgba(44, 27, 20, 0.04), 0 1px 3px rgba(44, 27, 20, 0.06);
  transition: transform 150ms cubic-bezier(0.4, 0, 0.2, 1), box-shadow 250ms cubic-bezier(0.4, 0, 0.2, 1), border-color 250ms cubic-bezier(0.4, 0, 0.2, 1);
  /* === 冷热卡片氛围：状态融入整张卡片的气质，而非孤立标签 === */
  /* 冰饮：右上一抹冰蓝渐变晕染 + 冷色描边 */
  /* 热饮：右上一抹暖橙渐变晕染 + 暖色描边（贴近咖啡主题的暖调） */
}
.dish-card.data-v-215fb416:active {
  transform: scale(0.98);
  box-shadow: 0 2px 8px rgba(44, 27, 20, 0.06), 0 4px 16px rgba(44, 27, 20, 0.04);
}
.dish-card.temp-ice.data-v-215fb416 {
  background: linear-gradient(135deg, #FFFFFF 52%, rgba(191, 219, 254, 0.38) 100%);
  border-color: rgba(147, 197, 253, 0.55);
}
.dish-card.temp-hot.data-v-215fb416 {
  background: linear-gradient(135deg, #FFFFFF 52%, rgba(254, 215, 170, 0.42) 100%);
  border-color: rgba(253, 186, 116, 0.55);
}

/* 左侧图片：圆角方形，无图显示 emoji */
.dish-image.data-v-215fb416 {
  position: relative;
  flex-shrink: 0;
  width: 128rpx;
  height: 128rpx;
  border-radius: 12px;
  overflow: hidden;
  background-color: var(--theme-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
}
.dish-image .img.data-v-215fb416 {
  width: 100%;
  height: 100%;
}
.dish-image .emoji.data-v-215fb416 {
  font-size: 56rpx;
  line-height: 1;
}

/* === 冷热氛围动效层（覆盖在图片上，不响应点击） === */
.temp-fx.data-v-215fb416 {
  position: absolute;
  inset: 0;
  pointer-events: none;
  /* 热饮：三缕热气自杯中袅袅升起 */
  /* 冰饮：一道冰霜流光周期性扫过杯面 */
}
.temp-fx.hot .steam-wisp.data-v-215fb416 {
  position: absolute;
  bottom: 30rpx;
  width: 7rpx;
  height: 20rpx;
  border-radius: 9999px;
  background-color: rgba(255, 255, 255, 0.9);
  box-shadow: 0 0 10rpx rgba(255, 255, 255, 0.8);
  opacity: 0;
  animation: steamRise-215fb416 2.4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}
.temp-fx.hot .wisp-1.data-v-215fb416 {
  left: 40rpx;
}
.temp-fx.hot .wisp-2.data-v-215fb416 {
  left: 60rpx;
  height: 26rpx;
  animation-delay: 0.8s;
}
.temp-fx.hot .wisp-3.data-v-215fb416 {
  left: 80rpx;
  animation-delay: 1.6s;
}
.temp-fx.ice .frost-sheen.data-v-215fb416 {
  position: absolute;
  top: -40%;
  left: -70%;
  width: 44rpx;
  height: 180%;
  transform: rotate(22deg);
  background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.65) 50%, rgba(255, 255, 255, 0) 100%);
  animation: frostSweep-215fb416 2.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}
@keyframes steamRise-215fb416 {
0% {
    transform: translateY(10rpx) scaleX(1);
    opacity: 0;
}
30% {
    opacity: 0.85;
}
60% {
    transform: translateY(-16rpx) scaleX(1.4);
}
100% {
    transform: translateY(-36rpx) scaleX(0.8);
    opacity: 0;
}
}
@keyframes frostSweep-215fb416 {
0% {
    left: -70%;
}
60%, 100% {
    left: 130%;
}
}
/* === 冷热角标：图片左下角的渐变胶囊 === */
.temp-chip.data-v-215fb416 {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 3rpx 14rpx;
  border-radius: 9999px;
  line-height: 1.5;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}
.temp-chip .temp-chip-icon.data-v-215fb416 {
  font-size: 20rpx;
  line-height: 1;
  color: #fff;
}
.temp-chip .temp-chip-text.data-v-215fb416 {
  font-size: 20rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 1rpx;
}
.temp-chip.ice.data-v-215fb416 {
  background: linear-gradient(135deg, #7cb3f7 0%, #4a8cef 100%);
}
.temp-chip.hot.data-v-215fb416 {
  background: linear-gradient(135deg, #fbb25c 0%, #ef7d1a 100%);
}


/* 圆角 */
.dish-card.data-v-215fb416 {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background-color: #FFFFFF;
  border: 2rpx solid var(--theme-card-border, #F5E6D3);
  border-radius: 16px;
  box-shadow: 0 1px 2px rgba(44, 27, 20, 0.04), 0 1px 3px rgba(44, 27, 20, 0.06);
  transition: transform 150ms cubic-bezier(0.4, 0, 0.2, 1), box-shadow 250ms cubic-bezier(0.4, 0, 0.2, 1);
}
.dish-card.data-v-215fb416:active {
  transform: scale(0.98);
  box-shadow: 0 2px 8px rgba(44, 27, 20, 0.06), 0 4px 16px rgba(44, 27, 20, 0.04);
}

/* 左侧图片：圆角方形，无图显示 emoji */
.dish-image.data-v-215fb416 {
  flex-shrink: 0;
  width: 128rpx;
  height: 128rpx;
  border-radius: 12px;
  overflow: hidden;
  background-color: var(--theme-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
}
.dish-image .img.data-v-215fb416 {
  width: 100%;
  height: 100%;
}
.dish-image .emoji.data-v-215fb416 {
  font-size: 56rpx;
  line-height: 1;
}

/* 中间信息区 */
.dish-info.data-v-215fb416 {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.dish-info .dish-name-row.data-v-215fb416 {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.dish-info .dish-name.data-v-215fb416 {
  flex: 1;
  min-width: 0;
  font-size: 14px;
  font-weight: 700;
  color: var(--theme-text);
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dish-info .temp-badge.data-v-215fb416 {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 2rpx;
  padding: 2rpx 12rpx;
  border-radius: 9999px;
  line-height: 1.6;
}
.dish-info .temp-badge .temp-badge-icon.data-v-215fb416 {
  font-size: 18rpx;
  line-height: 1;
}
.dish-info .temp-badge .temp-badge-text.data-v-215fb416 {
  font-size: 10px;
  font-weight: 500;
}
.dish-info .temp-badge.ice.data-v-215fb416 {
  background-color: #EFF6FF;
}
.dish-info .temp-badge.ice .temp-badge-icon.data-v-215fb416, .dish-info .temp-badge.ice .temp-badge-text.data-v-215fb416 {
  color: #2563EB;
}
.dish-info .temp-badge.hot.data-v-215fb416 {
  background-color: #FEF2F2;
}
.dish-info .temp-badge.hot .temp-badge-icon.data-v-215fb416, .dish-info .temp-badge.hot .temp-badge-text.data-v-215fb416 {
  color: #DC2626;
}
.dish-info .dish-desc.data-v-215fb416 {
  font-size: 10px;
  color: #78716C;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dish-info .dish-tag.data-v-215fb416 {
  align-self: flex-start;
  margin-top: 4rpx;
  padding: 2rpx 12rpx;
  border-radius: 9999px;
  background-color: var(--theme-secondary);
  line-height: 1.6;
}
.dish-info .dish-tag .tag-text.data-v-215fb416 {
  font-size: 10px;
  color: var(--theme-secondary-foreground);
  font-weight: 500;
}

/* 右侧"+"按钮 */
.add-btn.data-v-215fb416 {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: var(--theme-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 150ms cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 250ms cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
}
.add-btn.data-v-215fb416:active {
  transform: scale(0.85) rotate(90deg);
}
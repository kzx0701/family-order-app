.skeleton-wrap.data-v-54f1e491 {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 0;
}

/* 通用骨架块：灰色底 + shimmer 流光 */
.sk-line.data-v-54f1e491 {
  height: 24rpx;
  border-radius: 4px;
  background-color: #F5F5F4;
  position: relative;
  overflow: hidden;
  /* shimmer 流光：渐变背景水平移动 */
}
.sk-line.data-v-54f1e491::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.65) 50%, transparent 100%);
  background-size: 200% 100%;
  animation: shimmer-54f1e491 1.6s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}
.sk-line-title.data-v-54f1e491 {
  width: 60%;
  height: 28rpx;
}
.sk-line-sub.data-v-54f1e491 {
  width: 40%;
  margin-top: 12rpx;
}
.sk-line-meta.data-v-54f1e491 {
  width: 30%;
  height: 20rpx;
}
.sk-line-short.data-v-54f1e491 {
  width: 20%;
}
.sk-row.data-v-54f1e491 {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

/* === 卡片骨架 === */
.sk-card.data-v-54f1e491 {
  padding: 24rpx;
  background-color: #FFFFFF;
  border-radius: 16px;
  box-shadow: 0 1px 2px rgba(44, 27, 20, 0.04), 0 1px 3px rgba(44, 27, 20, 0.06);
}
.sk-card.is-first.data-v-54f1e491 {
  /* 首卡片更醒目一点，模拟数据焦点 */
}


/**
 * 双主题类
 * 通过给页面/容器添加 .theme-coffee 或 .theme-food 切换主题色
 * 主题色以 CSS 变量暴露，运行时可动态切换（适合点单页咖啡/美食共用）
 *
 * 使用方式：
 *   <view class="theme-coffee">...</view>
 *   <view class="theme-food">...</view>
 * 组件内引用：background-color: var(--theme-primary);
 */
/* 默认根变量（暖奶油底色，无主题倾向） */
page {
  --theme-primary: #6F4E37;
  --theme-primary-foreground: #FFFFFF;
  --theme-secondary: #F5E6D3;
  --theme-secondary-foreground: #5C4033;
  --theme-accent: #D4A574;
  --theme-soft: #FDF8F0;
  --theme-text: #3E2723;
}
/* 咖啡主题：棕色系 */
.theme-coffee {
  --theme-primary: #6F4E37;
  --theme-primary-foreground: #FFFFFF;
  --theme-secondary: #F5E6D3;
  --theme-secondary-foreground: #5C4033;
  --theme-accent: #D4A574;
  --theme-soft: #FDF8F0;
  --theme-text: #3E2723;
  --theme-grad-start: #F5E6D3;
  --theme-grad-end: #E8D0B3;
  --theme-card-border: #F5E6D3;
}
/* 美食主题：绿色系 */
.theme-food {
  --theme-primary: #4A5E38;
  --theme-primary-foreground: #FFFFFF;
  --theme-secondary: #E8EDE2;
  --theme-secondary-foreground: #3A4A2C;
  --theme-accent: #A3B491;
  --theme-soft: #F5F7F2;
  --theme-text: #2D3922;
  --theme-grad-start: #E8EDE2;
  --theme-grad-end: #C9D4BD;
  --theme-card-border: #E8EDE2;
}
/* 状态标签色变量（供状态徽章复用） */
.status-pending {
  --status-bg: #FEF3C7;
  --status-fg: #B45309;
}
.status-preparing {
  --status-bg: #DBEAFE;
  --status-fg: #1D4ED8;
}
.status-completed {
  --status-bg: #E8EDE2;
  --status-fg: #4A5E38;
}
.status-cancelled {
  --status-bg: #FEE2E2;
  --status-fg: #B91C1C;
}
/**
 * 通用动画 keyframes 与工具类
 * 在 App.vue 中全局引入一次（避免重复输出）
 * 使用方式：在元素上添加 .animate-fade-in 等工具类
 */
/* === 淡入 === */
@keyframes fadeIn {
from {
    opacity: 0;
}
to {
    opacity: 1;
}
}
/* === 从下方滑入 === */
@keyframes slideUp {
from {
    opacity: 0;
    transform: translateY(40rpx);
}
to {
    opacity: 1;
    transform: translateY(0);
}
}
/* === 从上方滑入 === */
@keyframes slideDown {
from {
    opacity: 0;
    transform: translateY(-40rpx);
}
to {
    opacity: 1;
    transform: translateY(0);
}
}
/* === 弹出（带回弹） === */
@keyframes popIn {
0% {
    opacity: 0;
    transform: scale(0.6);
}
60% {
    opacity: 1;
    transform: scale(1.08);
}
100% {
    transform: scale(1);
}
}
/* === 飞入购物车 === */
@keyframes flyToCart {
0% {
    opacity: 1;
    transform: translate(0, 0) scale(1);
}
60% {
    opacity: 1;
    transform: translate(var(--fly-x, 0), var(--fly-y, 0)) scale(0.5);
}
100% {
    opacity: 0;
    transform: translate(var(--fly-x, 0), var(--fly-y, 0)) scale(0.2);
}
}
/* === 弹跳（购物车图标收到新商品） === */
@keyframes bounce {
0%, 100% {
    transform: scale(1);
}
30% {
    transform: scale(1.25);
}
60% {
    transform: scale(0.9);
}
}
/* === 心跳脉冲 === */
@keyframes pulse {
0%, 100% {
    transform: scale(1);
    opacity: 1;
}
50% {
    transform: scale(1.05);
    opacity: 0.85;
}
}
/* === 旋转加载 === */
@keyframes spin {
from {
    transform: rotate(0deg);
}
to {
    transform: rotate(360deg);
}
}
/* === 摇晃（错误提示） === */
@keyframes shake {
0%, 100% {
    transform: translateX(0);
}
20%, 60% {
    transform: translateX(-10rpx);
}
40%, 80% {
    transform: translateX(10rpx);
}
}
/* === 闪光（成功页装饰） === */
@keyframes shimmer {
0% {
    background-position: -200% 0;
}
100% {
    background-position: 200% 0;
}
}
/* === 动画工具类 === */
.animate-fade-in {
  animation: fadeIn 250ms cubic-bezier(0.4, 0, 0.2, 1) both;
}
.animate-slide-up {
  animation: slideUp 250ms cubic-bezier(0.4, 0, 0.2, 1) both;
}
.animate-slide-down {
  animation: slideDown 250ms cubic-bezier(0.4, 0, 0.2, 1) both;
}
.animate-pop-in {
  animation: popIn 250ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
}
.animate-fly-to-cart {
  animation: flyToCart 400ms cubic-bezier(0.4, 0, 0.2, 1) both;
}
.animate-bounce {
  animation: bounce 400ms cubic-bezier(0.34, 1.56, 0.64, 1);
}
.animate-pulse {
  animation: pulse 1.5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}
.animate-spin {
  animation: spin 800ms linear infinite;
}
.animate-shake {
  animation: shake 400ms cubic-bezier(0.4, 0, 0.2, 1);
}
/* === 列表项依次进入动画（配合 v-for + :style="{animationDelay}") === */
.animate-item-enter {
  animation: slideUp 250ms cubic-bezier(0.4, 0, 0.2, 1) both;
}
page {
  background-color: #FFFBF5;
  color: #2C1B14;
  font-family: "Inter", -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 14px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}
/* 全局视图容器：暖奶油底色，铺满整屏 */
view, text {
  box-sizing: border-box;
}
/* 隐藏滚动条（小程序专用） */
::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}
/* === 页面入场动效：onShow 时为根容器淡入 === */
/* 用法：在页面根 view 上加 class="page-enter" */
/* 注意：fill-mode 必须是 backwards 而非 both —— both 会在动画结束后保留 */
/* transform: translateY(0)，使根容器成为 fixed 后代的包含块，导致固定 */
/* 标题栏/底部 tabbar 随页面滚动而失效 */
.page-enter {
  animation: pageEnter 250ms cubic-bezier(0.4, 0, 0.2, 1) backwards;
}
@keyframes pageEnter {
from {
    opacity: 0;
    transform: translateY(8rpx);
}
to {
    opacity: 1;
    transform: translateY(0);
}
}
/* === 通用 shimmer 占位（骨架屏基础类） === */
.shimmer-bg {
  background-color: #F5F5F4;
  background-image: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.65) 50%, transparent 100%);
  background-size: 200% 100%;
  animation: shimmer 1.6s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}
/* === 通用点击反馈增强：按钮按下时轻微缩放 + 阴影收敛 === */
/* 用于希望加强按下反馈但未使用 mixin 的元素 */
.tap-scale {
  transition: transform 150ms cubic-bezier(0.4, 0, 0.2, 1);
}
.tap-scale:active {
  transform: scale(0.96);
}
/* === 全局 image 默认行为：防止图片下方基线间隙 === */
image {
  display: block;
}
/* === 文字层级工具类 === */
.text-title {
  font-size: 16px;
  font-weight: 600;
  color: #3E2723;
}
.text-body {
  font-size: 14px;
  color: #2C1B14;
}
.text-muted {
  font-size: 12px;
  color: #78716C;

/* === 成功动效区 === */
.hero.data-v-982e71f9 {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 0 56rpx;
  /* 圆圈容器：所有动效元素（光环/彩屑/对勾/Lottie）的定位基准 */
  /* 扩散光环：相对 circle-wrap 居中，不再依赖 hero 的 padding */
  /* 彩屑层：相对 circle-wrap 中心爆开 */
  /* 绿色对勾圆圈：先弹入入场（popIn），完成后持续呼吸（circleBreathe） */
  /* Lottie canvas：覆盖在 success-circle 上层，同尺寸 */
}
.hero .circle-wrap.data-v-982e71f9 {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  z-index: 2;
}
.hero .ring.data-v-982e71f9 {
  position: absolute;
  top: 0;
  left: 0;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(34, 197, 94, 0.35);
  pointer-events: none;
  z-index: 0;
}
.hero .ring-1.data-v-982e71f9 {
  animation: ringExpand-982e71f9 2s cubic-bezier(0.4, 0, 0.2, 1) 0.3s infinite;
}
.hero .ring-2.data-v-982e71f9 {
  animation: ringExpand-982e71f9 2s cubic-bezier(0.4, 0, 0.2, 1) 0.9s infinite;
}
.hero .confetti-layer.data-v-982e71f9 {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  pointer-events: none;
  z-index: 1;
}
.hero .confetti.data-v-982e71f9 {
  position: absolute;
  top: 0;
  left: 0;
  border-radius: 4rpx;
  transition: transform 1.1s cubic-bezier(0.16, 1, 0.3, 1), opacity 1.1s cubic-bezier(0.4, 0, 0.2, 1);
  will-change: transform, opacity;
}
.hero .success-circle.data-v-982e71f9 {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: linear-gradient(135deg, #22C55E, #16A34A);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 40rpx rgba(34, 197, 94, 0.4);
  animation: popIn 250ms cubic-bezier(0.34, 1.56, 0.64, 1) both,circleBreathe-982e71f9 2.4s cubic-bezier(0.4, 0, 0.2, 1) 0.6s infinite;
  z-index: 2;
}
.hero .success-lottie-canvas.data-v-982e71f9 {
  position: absolute;
  inset: 0;
  width: 160rpx;
  height: 160rpx;
  z-index: 3;
}
.hero .success-title.data-v-982e71f9 {
  margin-top: 36rpx;
  font-size: 28px;
  font-weight: 700;
  color: #5C4033;
  animation-delay: 0.2s;
}
.hero .success-sub.data-v-982e71f9 {
  margin-top: 12rpx;
  font-size: 14px;
  color: #78716C;
  animation-delay: 0.35s;
}
@keyframes ringExpand-982e71f9 {
0% {
    transform: scale(1);
    opacity: 0.6;
}
100% {
    transform: scale(2.2);
    opacity: 0;
}
}
@keyframes circleBreathe-982e71f9 {
0%, 100% {
    transform: scale(1);
}
50% {
    transform: scale(1.05);
}
}

.page-record.data-v-ef6850c5 {
  min-height: 100vh;
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
  background-color: #FFFBF5;
}

/* === 顶部 header（fixed 固定，滚动时常驻顶部） === */
.header.data-v-ef6850c5 {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  padding: 56rpx 40rpx 24rpx;
  background-color: #FFFBF5;
}
.header .title.data-v-ef6850c5 {
  display: block;
  font-size: 22px;
  font-weight: 700;
  color: #5C4033;
  line-height: 1.25;
}
.header .subtitle.data-v-ef6850c5 {
  display: block;
  margin-top: 8rpx;
  font-size: 12px;
  color: #78716C;
}

/* === 加载状态 === */
.skeleton-wrap-record.data-v-ef6850c5 {
  padding: 0 32rpx;
}
.loading-state.data-v-ef6850c5 {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 120rpx 0;
}
.loading-state .loading-dot.data-v-ef6850c5 {
  font-size: 22px;
  color: #C4956A;
  animation: dotBlink-ef6850c5 1.2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}
.loading-state .loading-dot.data-v-ef6850c5:nth-child(2) {
  animation-delay: 0.2s;
}
.loading-state .loading-dot.data-v-ef6850c5:nth-child(3) {
  animation-delay: 0.4s;
}
@keyframes dotBlink-ef6850c5 {
0%, 100% {
    opacity: 0.3;
}
50% {
    opacity: 1;
}
}
/* === 分组列表 === */
.group-list.data-v-ef6850c5 {
  padding: 0 32rpx;
}
.group-list .group.data-v-ef6850c5 {
  margin-bottom: 32rpx;
}
.group-list .group .group-header.data-v-ef6850c5 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx;
  margin-bottom: 16rpx;
}
.group-list .group .group-header .group-date.data-v-ef6850c5 {
  font-size: 12px;
  font-weight: 600;
  color: #8B6F47;
}
.group-list .group .group-header .group-count.data-v-ef6850c5 {
  font-size: 10px;
  color: #A8A29E;
}
.group-list .group .order-list.data-v-ef6850c5 {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* === 滑动卡片容器 === */
.swipe-item.data-v-ef6850c5 {
  position: relative;
  overflow: hidden;
  border-radius: 16px;
}

/* 右侧滑动操作区：圆角块状按钮 */
.swipe-actions.data-v-ef6850c5 {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  padding: 16rpx 16rpx 16rpx 0;
  z-index: 1;
}
.swipe-actions .swipe-btn.data-v-ef6850c5 {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 144rpx;
  font-size: 12px;
  font-weight: 600;
  color: #fff;
  border-radius: 16px;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.12);
}
.swipe-actions .swipe-btn.data-v-ef6850c5:active {
  opacity: 0.92;
  transform: scale(0.96);
}
.swipe-actions .swipe-cancel.data-v-ef6850c5 {
  background: linear-gradient(135deg, #9CA3AF, #6B7280);
}
.swipe-actions .swipe-delete.data-v-ef6850c5 {
  background: linear-gradient(135deg, #EF4444, #DC2626);
}


.page-my.data-v-2f1ef635 {
  min-height: 100vh;
  padding: 0 28rpx calc(180rpx + env(safe-area-inset-bottom));
  background: #fff9ed;
  color: #624735;
}
.profile-card.data-v-2f1ef635 {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 44rpx;
  text-align: center;
}
.avatar-wrap.data-v-2f1ef635 {
  position: relative;
  width: 146rpx;
  height: 146rpx;
  /* 不设 padding：头像直接贴到描边内侧，去掉原先 7rpx 的白色间隙
     （该间隙与页面底色几乎同色，读不出「白边」的设计意图，只显得图片离边框远） */
  padding: 0;
  border: 3rpx solid #765540;
  border-radius: 47% 53% 49% 51%;
  background: #fffef9;
  box-shadow: 5rpx 6rpx 0 rgba(98, 71, 53, 0.12);
  overflow: hidden;
}
.avatar-image.data-v-2f1ef635 {
  width: 100%;
  height: 100%;
  border-radius: inherit;
}
.profile-main.data-v-2f1ef635 {
  margin-top: 22rpx;
  max-width: 100%;
}
.profile-name.data-v-2f1ef635 {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.4;
  overflow-wrap: anywhere;
}
.mode-chip.data-v-2f1ef635 {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  padding: 5rpx 16rpx;
  border: 2rpx solid rgba(118, 85, 64, 0.3);
  border-radius: 14rpx 18rpx 13rpx 16rpx;
  background: #f8c1b4;
  font-size: 21rpx;
  color: #624735;
}
.mode-chip.cook.data-v-2f1ef635 {
  background: #dbe8c8;
}
.mode-dot.data-v-2f1ef635 {
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: currentColor;
}
.edit-mark.data-v-2f1ef635 {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 64rpx;
  margin-top: 10rpx;
  padding: 0 22rpx;
  color: #8c725e;
  font-size: 22rpx;
}
.edit-mark.data-v-2f1ef635:active {
  opacity: 0.6;
}
.menu-list.data-v-2f1ef635 {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.info-card.data-v-2f1ef635,
.record-entry.data-v-2f1ef635 {
  position: relative;
  display: flex;
  align-items: center;
  gap: 22rpx;
  height: 148rpx;
  box-sizing: border-box;
  padding: 18rpx 24rpx;
  border: 3rpx solid #765540;
  border-radius: 26rpx 32rpx 25rpx 30rpx;
  box-shadow: 4rpx 5rpx 0 rgba(98, 71, 53, 0.12);
}
.family-card.data-v-2f1ef635 {
  background: #f9edce;
}
.mode-card.data-v-2f1ef635 {
  background: #e3eef0;
}
.record-entry.data-v-2f1ef635 {
  background: #dbe8c8;
}
.mode-card.data-v-2f1ef635,
.record-entry.data-v-2f1ef635 {
  transition: transform 140ms cubic-bezier(0.22, 0.75, 0.24, 1), box-shadow 140ms cubic-bezier(0.22, 0.75, 0.24, 1);
}
.mode-card.data-v-2f1ef635:active,
.record-entry.data-v-2f1ef635:active {
  transform: translate(2rpx, 3rpx);
  box-shadow: none;
}
.info-main.data-v-2f1ef635,
.record-copy.data-v-2f1ef635 {
  flex: 1;
  min-width: 0;
}
.menu-title.data-v-2f1ef635 {
  display: block;
  font-size: 29rpx;
  font-weight: 750;
  line-height: 1.4;
}
.menu-description.data-v-2f1ef635 {
  display: block;
  margin-top: 7rpx;
  color: #8c725e;
  font-size: 21rpx;
  line-height: 1.5;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.record-arrow.data-v-2f1ef635 {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 auto;
  border: 2rpx solid rgba(118, 85, 64, 0.6);
  border-radius: 48% 52% 46% 54%;
  background: #fffef9;
  color: #8c725e;
}
.menu-art.data-v-2f1ef635 {
  display: block;
  width: 96rpx;
  height: 106rpx;
  flex: 0 0 96rpx;
}
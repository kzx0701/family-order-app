/* === 返回按钮（深色毛玻璃，浮于大图之上） === */
.back-btn.data-v-f1b4097a {
  position: fixed;
  top: 32rpx;
  left: 28rpx;
  z-index: 100;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: rgba(44, 27, 20, 0.35);

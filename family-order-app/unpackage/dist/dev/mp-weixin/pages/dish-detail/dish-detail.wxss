  line-height: 1.75;
}
.info-card .qty-row.data-v-f1b4097a {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 40rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid #F5F5F4;
}
.info-card .qty-row .qty-label.data-v-f1b4097a {
  font-size: 14px;
  color: #2C1B14;
  font-weight: 500;
}
.info-card .qty-row .qty-control.data-v-f1b4097a {
  display: flex;
  align-items: center;
  gap: 32rpx;
}
.info-card .qty-row .qty-control .qty-btn.data-v-f1b4097a {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 150ms cubic-bezier(0.4, 0, 0.2, 1);
  transition: background-color 250ms cubic-bezier(0.4, 0, 0.2, 1), border-color 250ms cubic-bezier(0.4, 0, 0.2, 1), color 250ms cubic-bezier(0.4, 0, 0.2, 1), opacity 150ms cubic-bezier(0.4, 0, 0.2, 1);
}
.info-card .qty-row .qty-control .qty-btn.data-v-f1b4097a:active {
  transform: scale(0.9);
}
.info-card .qty-row .qty-control .qty-minus.data-v-f1b4097a {
  background-color: #FFFFFF;
  border: 2rpx solid var(--theme-primary);
  color: var(--theme-primary);
}
.info-card .qty-row .qty-control .qty-minus.disabled.data-v-f1b4097a {
  border-color: #D6D3D1;
  color: #A8A29E;

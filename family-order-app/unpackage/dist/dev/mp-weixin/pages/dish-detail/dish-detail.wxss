.page-detail.data-v-f1b4097a {
  position: relative;
  min-height: 100vh;
  background-color: #FFFBF5;
}

/* === 返回按钮（毛玻璃圆形） === */
.back-btn.data-v-f1b4097a {
  position: fixed;
  top: 32rpx;
  left: 32rpx;
  z-index: 100;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  color: var(--theme-text);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 1px 2px rgba(44, 27, 20, 0.04), 0 1px 3px rgba(44, 27, 20, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 150ms cubic-bezier(0.4, 0, 0.2, 1);
}
.back-btn.data-v-f1b4097a:active {
  transform: scale(0.9);
}

/* === 加载 / 错误状态 === */
.state-block.data-v-f1b4097a {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  min-height: 100vh;
  padding: 80rpx 0;
}
.state-block .loading-dots.data-v-f1b4097a {
  display: flex;
  gap: 8rpx;
}
.state-block .loading-dots .dot.data-v-f1b4097a {
  font-size: 28px;
  color: var(--theme-primary);
  animation: dotBlink-f1b4097a 1.2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}
.state-block .loading-dots .dot.data-v-f1b4097a:nth-child(2) {
  animation-delay: 0.2s;
}
.state-block .loading-dots .dot.data-v-f1b4097a:nth-child(3) {
  animation-delay: 0.4s;
}
.state-block .state-emoji.data-v-f1b4097a {
  font-size: 96rpx;
  line-height: 1;
}
.state-block .state-text.data-v-f1b4097a {
  font-size: 12px;
  color: #78716C;
  text-align: center;
}
.state-block .state-action.data-v-f1b4097a {
  margin-top: 8rpx;
  padding: 14rpx 40rpx;
  border-radius: 9999px;
  background-color: var(--theme-secondary);
  transition: transform 150ms cubic-bezier(0.4, 0, 0.2, 1);
}
.state-block .state-action.data-v-f1b4097a:active {
  transform: scale(0.96);
}
.state-block .state-action .state-action-text.data-v-f1b4097a {
  color: var(--theme-primary);
  font-size: 12px;
  font-weight: 500;
}
@keyframes dotBlink-f1b4097a {
0%, 100% {
    opacity: 0.3;
}
50% {
    opacity: 1;
}
}
/* === 顶部大图 === */
.hero.data-v-f1b4097a {
  position: relative;
  width: 100%;
  height: 520rpx;
  background-color: var(--theme-secondary);
  overflow: hidden;
  border-radius: 0 0 40rpx 40rpx;
}
.hero .hero-img.data-v-f1b4097a {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 130%;
  will-change: transform;
}
.hero .hero-placeholder.data-v-f1b4097a {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 160rpx;
  line-height: 1;
  animation: pulse 2.4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}
.hero .hero-mask.data-v-f1b4097a {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0) 55%, rgba(0, 0, 0, 0.28) 100%);
  pointer-events: none;
}

/* === 信息卡 === */
.info-card.data-v-f1b4097a {
  position: relative;
  z-index: 2;
  margin: -48rpx 32rpx 0;
  padding: 40rpx;
  background-color: #FFFFFF;
  border-radius: 20px;
  box-shadow: 0 2px 8px rgba(44, 27, 20, 0.06), 0 4px 16px rgba(44, 27, 20, 0.04);
  display: flex;
  flex-direction: column;
}
.info-card .category-pill.data-v-f1b4097a {
  align-self: flex-start;
  padding: 6rpx 20rpx;
  border-radius: 9999px;
  background-color: var(--theme-secondary);
  margin-bottom: 20rpx;
}
.info-card .category-pill .pill-text.data-v-f1b4097a {
  font-size: 10px;
  color: var(--theme-secondary-foreground);
  font-weight: 500;
}
.info-card .name.data-v-f1b4097a {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--theme-text);

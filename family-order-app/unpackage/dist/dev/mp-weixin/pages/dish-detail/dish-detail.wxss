  text-align: center;
  font-size: 18px;
  font-weight: 700;
  color: #2C1B14;
}

/* === 底部留白 === */
.bottom-spacer.data-v-f1b4097a {
  height: 220rpx;
}

/* === 底部固定栏：按钮直接贴底，无背景容器 === */
.bottom-bar.data-v-f1b4097a {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  flex-direction: column;
}
.bottom-bar .add-btn.data-v-f1b4097a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  border-radius: 9999px;
  font-weight: 500;
  font-size: 14px;
  line-height: 1;
  transition: transform 150ms cubic-bezier(0.4, 0, 0.2, 1), opacity 150ms cubic-bezier(0.4, 0, 0.2, 1);
  background-color: var(--theme-primary);
  color: var(--theme-primary-foreground);
  width: 100%;
  padding: 32rpx 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 0;
  font-size: 16px;
  font-weight: 600;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: transform 150ms cubic-bezier(0.34, 1.56, 0.64, 1), opacity 150ms cubic-bezier(0.4, 0, 0.2, 1);
}
.bottom-bar .add-btn.data-v-f1b4097a:active {
  transform: scale(0.96);
  opacity: 0.85;
}
.bottom-bar .add-btn .add-text.data-v-f1b4097a {
  color: inherit;
}
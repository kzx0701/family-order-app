/* === 顶部大图：餐品主视觉 === */
.hero.data-v-f1b4097a {
  position: relative;
  width: 100%;
  height: 640rpx;
  background-color: var(--theme-secondary);
  overflow: hidden;
  /* === 冷热氛围层（纯图形，与列表 dish-card 同款语言） === */
  /* === 冷热标识：毛玻璃胶囊，大图左下角 === */
}
.hero .hero-img.data-v-f1b4097a {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 130%;
  will-change: transform;
}
.hero .hero-placeholder.data-v-f1b4097a {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 200rpx;
  line-height: 1;
  animation: pulse 2.4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}
.hero .hero-top-mask.data-v-f1b4097a {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 220rpx;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0));
  pointer-events: none;
}
.hero .hero-bottom-mask.data-v-f1b4097a {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 160rpx;
  background: linear-gradient(to top, #FFFBF5, rgba(255, 251, 245, 0));
  pointer-events: none;
}
.hero .temp-fx.data-v-f1b4097a {
  position: absolute;
  inset: 0;
  pointer-events: none;
  /* 热饮：三缕热气自杯中袅袅升起 */
  /* 冰饮：静态霜感——杯底冷雾 + 固定磨砂高光（无循环动效） */
}
.hero .temp-fx.hot .steam-wisp.data-v-f1b4097a {
  position: absolute;
  bottom: 200rpx;
  width: 10rpx;
  height: 40rpx;
  border-radius: 9999px;
  background-color: rgba(255, 255, 255, 0.9);
  box-shadow: 0 0 16rpx rgba(255, 255, 255, 0.8);
  opacity: 0;
  animation: steamRise-f1b4097a 2.6s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}
.hero .temp-fx.hot .wisp-1.data-v-f1b4097a {
  left: 42%;
}
.hero .temp-fx.hot .wisp-2.data-v-f1b4097a {
  left: 50%;
  height: 52rpx;
  animation-delay: 0.9s;
}
.hero .temp-fx.hot .wisp-3.data-v-f1b4097a {
  left: 58%;
  animation-delay: 1.8s;
}
.hero .temp-fx.ice .frost-mist.data-v-f1b4097a {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 220rpx;
  background: radial-gradient(ellipse at 50% 100%, rgba(186, 216, 255, 0.28) 0%, rgba(186, 216, 255, 0) 72%);
}
.hero .temp-fx.ice .frost-sheen-static.data-v-f1b4097a {
  position: absolute;
  top: -40%;
  left: -30%;
  width: 90rpx;
  height: 180%;
  transform: rotate(22deg);
  background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.18) 50%, rgba(255, 255, 255, 0) 100%);
}
@keyframes steamRise-f1b4097a {
0% {
    transform: translateY(16rpx) scaleX(1);
    opacity: 0;
}
30% {
    opacity: 0.85;
}
60% {
    transform: translateY(-36rpx) scaleX(1.4);
}
100% {
    transform: translateY(-80rpx) scaleX(0.8);
    opacity: 0;
}
}
.hero .temp-chip.data-v-f1b4097a {
  position: absolute;
  left: 32rpx;
  bottom: 96rpx;
  z-index: 3;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 22rpx;
  border-radius: 9999px;
  background-color: rgba(255, 255, 255, 0.22);

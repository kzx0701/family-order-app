}
.status-hero .status-badge-lg .status-dot-lg.data-v-71729483 {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: currentColor;
  animation: dotPulse-71729483 1.6s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}
.status-hero .status-badge-lg .status-label-lg.data-v-71729483 {

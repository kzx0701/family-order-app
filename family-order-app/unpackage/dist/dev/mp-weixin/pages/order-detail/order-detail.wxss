}

/* === 头部（sticky） === */
.header.data-v-71729483 {
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 32rpx 24rpx;
  background-color: #FFFBF5;
}
.header .back-btn.data-v-71729483 {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: var(--theme-secondary);
  color: var(--theme-primary);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: transform 150ms cubic-bezier(0.4, 0, 0.2, 1);
}
.header .back-btn.data-v-71729483:active {
  transform: scale(0.9);
}
.header .title.data-v-71729483 {
  font-size: 18px;
  font-weight: 700;
  color: var(--theme-primary, #5C4033);
}
.header .placeholder.data-v-71729483 {
  width: 72rpx;
}

/* === 加载 / 错误状态 === */
.state-block.data-v-71729483 {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 120rpx 0;
}
.state-block .loading-dots.data-v-71729483 {
  display: flex;
  gap: 8rpx;
}
.state-block .loading-dots .dot.data-v-71729483 {
  font-size: 28px;
  color: var(--theme-primary, #8B6F47);
  animation: dotBlink-71729483 1.2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}
.state-block .loading-dots .dot.data-v-71729483:nth-child(2) {
  animation-delay: 0.2s;
}
.state-block .loading-dots .dot.data-v-71729483:nth-child(3) {
  animation-delay: 0.4s;
}
.state-block .state-text.data-v-71729483 {
  font-size: 12px;
  color: #78716C;
}
@keyframes dotBlink-71729483 {
0%, 100% {
    opacity: 0.3;
}
50% {
    opacity: 1;
}
}
/* === 状态 Hero 区 === */
.status-hero.data-v-71729483 {
  padding: 24rpx 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;

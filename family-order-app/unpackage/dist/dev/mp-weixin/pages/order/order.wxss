/* === 加载与空状态 === */
.state-block.data-v-93207a4f {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 120rpx 0;
}
.state-block .loading-dots.data-v-93207a4f {
  display: flex;
  gap: 8rpx;
}
.state-block .loading-dots .dot.data-v-93207a4f {
  font-size: 22px;
  color: var(--theme-primary);
  animation: dotBlink-93207a4f 1.2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}
.state-block .loading-dots .dot.data-v-93207a4f:nth-child(2) {
  animation-delay: 0.2s;
}
.state-block .loading-dots .dot.data-v-93207a4f:nth-child(3) {
  animation-delay: 0.4s;
}
.state-block .state-emoji.data-v-93207a4f {
  font-size: 96rpx;
  line-height: 1;
  animation: pulse 2.4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}
.state-block .state-text.data-v-93207a4f {
  font-size: 12px;
  color: #78716C;
  text-align: center;
  line-height: 1.75;
  white-space: pre-line;
}
.state-block .state-action.data-v-93207a4f {
  margin-top: 8rpx;
  padding: 12rpx 32rpx;
  border-radius: 9999px;
  background-color: var(--theme-secondary);
  transition: transform 150ms cubic-bezier(0.34, 1.56, 0.64, 1);
}
.state-block .state-action.data-v-93207a4f:active {
  transform: scale(0.96);
}
.state-block .state-action .state-action-text.data-v-93207a4f {
  color: var(--theme-primary);
  font-size: 12px;
  font-weight: 500;
}
@keyframes dotBlink-93207a4f {
0%, 100% {
    opacity: 0.3;
}
50% {
    opacity: 1;
}
}
/* === 底部购物车条：真悬浮毛玻璃条，列表内容从其下方滚过 === */
.cart-bar.data-v-93207a4f {
  position: fixed;
  left: 32rpx;

/* === 飞入动效层 === */
.fly-layer.data-v-93207a4f {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 9999;
}
.fly-item.data-v-93207a4f {
  position: fixed;
  left: 0;
  top: 0;
  width: 40px;
  height: 40px;
  pointer-events: none;
  animation: flyArc-93207a4f 0.8s cubic-bezier(0.4, 0, 0.6, 1) forwards;
}
.fly-item .fly-img.data-v-93207a4f {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 2rpx solid #fff;
  box-shadow: 0 2px 8px rgba(44, 27, 20, 0.06), 0 4px 16px rgba(44, 27, 20, 0.04);
}
.fly-item .fly-emoji.data-v-93207a4f {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  background-color: var(--theme-secondary);
  border-radius: 50%;
  border: 2rpx solid #fff;
  box-shadow: 0 2px 8px rgba(44, 27, 20, 0.06), 0 4px 16px rgba(44, 27, 20, 0.04);
}
@keyframes flyArc-93207a4f {
0% {
    transform: translate(var(--sx, 0), var(--sy, 0)) scale(1);
    opacity: 1;
}
50% {
    transform: translate(var(--px, 0), var(--py, 0)) scale(0.6);
    opacity: 1;
}
100% {
    transform: translate(var(--ex, 0), var(--ey, 0)) scale(0.2);
    opacity: 0;
}
}
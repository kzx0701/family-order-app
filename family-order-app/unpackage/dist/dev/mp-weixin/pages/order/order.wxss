  height: 88rpx;
  padding: 0 44rpx;
  border-radius: 9999px;
  transition: background-color 250ms cubic-bezier(0.4, 0, 0.2, 1), transform 150ms cubic-bezier(0.34, 1.56, 0.64, 1);

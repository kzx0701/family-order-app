}
.dish-list .dish-skeleton.data-v-93207a4f {
  padding: 16rpx 0;
}
.dish-list .dish-section.data-v-93207a4f {
  padding: 16rpx 0;
}
.dish-list .dish-section .section-header.data-v-93207a4f {

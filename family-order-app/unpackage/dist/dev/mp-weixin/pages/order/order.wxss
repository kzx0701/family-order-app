.page-order.data-v-93207a4f {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: #FFFBF5;
  transition: background-color 250ms cubic-bezier(0.4, 0, 0.2, 1);
}

/* === 顶部 header === */
.header.data-v-93207a4f {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 32rpx 24rpx;
  position: relative;
  z-index: 10;
}
.header .back-btn.data-v-93207a4f {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: var(--theme-secondary);
  color: var(--theme-primary);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: transform 150ms cubic-bezier(0.4, 0, 0.2, 1);
  transition: transform 150ms cubic-bezier(0.34, 1.56, 0.64, 1), background-color 250ms cubic-bezier(0.4, 0, 0.2, 1);
}
.header .back-btn.data-v-93207a4f:active {
  transform: scale(0.9);
}
.header .title.data-v-93207a4f {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 18px;
  font-weight: 700;
  color: var(--theme-primary);
  transition: color 250ms cubic-bezier(0.4, 0, 0.2, 1);
}

/* === 主体内容 === */
.content.data-v-93207a4f {
  flex: 1;
  min-height: 0;
  overflow: hidden;
  display: flex;
}

/* === 左侧分类导航 === */
.sidebar.data-v-93207a4f {
  width: 160rpx;
  background-color: var(--theme-secondary);
  flex-shrink: 0;
  height: 100%;
  transition: background-color 250ms cubic-bezier(0.4, 0, 0.2, 1);
}
.sidebar .cat-item.data-v-93207a4f {
  position: relative;
  padding: 32rpx 0;
  text-align: center;
  transition: background-color 250ms cubic-bezier(0.4, 0, 0.2, 1);
}
.sidebar .cat-item .cat-indicator.data-v-93207a4f {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%) scaleY(0);
  width: 6rpx;
  height: 48rpx;
  border-radius: 9999px;
  background-color: var(--theme-primary);
  transition: transform 250ms cubic-bezier(0.34, 1.56, 0.64, 1), background-color 250ms cubic-bezier(0.4, 0, 0.2, 1);
}
.sidebar .cat-item .cat-name.data-v-93207a4f {
  font-size: 12px;
  color: #78716C;
  transition: color 250ms cubic-bezier(0.4, 0, 0.2, 1);
}
.sidebar .cat-item.active.data-v-93207a4f {
  background-color: #FFFFFF;
}
.sidebar .cat-item.active .cat-indicator.data-v-93207a4f {
  transform: translateY(-50%) scaleY(1);
}
.sidebar .cat-item.active .cat-name.data-v-93207a4f {
  color: var(--theme-primary);
  font-weight: 600;
}


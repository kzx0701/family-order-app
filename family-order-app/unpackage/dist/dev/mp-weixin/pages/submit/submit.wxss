.page-submit.data-v-61228d3b {
  min-height: 100vh;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  background-color: #FFFBF5;
}

/* === 头部（sticky 固定，滚动时常驻顶部） === */
.header.data-v-61228d3b {
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 32rpx 24rpx;
  background-color: #FFFBF5;
}
.header .back-btn.data-v-61228d3b {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: var(--theme-secondary);
  color: var(--theme-primary);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: transform 150ms cubic-bezier(0.4, 0, 0.2, 1);
}
.header .back-btn.data-v-61228d3b:active {
  transform: scale(0.9);
}
.header .title.data-v-61228d3b {
  font-size: 18px;
  font-weight: 700;
  color: var(--theme-primary);
  transition: color 250ms cubic-bezier(0.4, 0, 0.2, 1);
}
.header .placeholder.data-v-61228d3b {
  width: 72rpx;
}

/* === 通用 section === */
.section.data-v-61228d3b {
  margin: 24rpx 32rpx;
  padding: 32rpx;
  background-color: #FFFFFF;
  border-radius: 20px;
  box-shadow: 0 1px 2px rgba(44, 27, 20, 0.04), 0 1px 3px rgba(44, 27, 20, 0.06);
}
.section-head.data-v-61228d3b {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 24rpx;
  color: var(--theme-primary);
}
.section-head .section-title.data-v-61228d3b {
  margin-bottom: 0;
}
.section-head .section-sub.data-v-61228d3b {
  margin-left: auto;
  font-size: 10px;
  color: #78716C;
  font-weight: 400;
}
.section-title.data-v-61228d3b {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: #2C1B14;
  margin-bottom: 24rpx;
}

